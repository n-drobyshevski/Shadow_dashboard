{
  "name": "shadow-it-dashboard-gas",
  "version": "1.0.0",
  "private": true,
  "description": "Shadow IT Dashboard — Google Apps Script web app (port of the Streamlit dashboard)",
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:e2e": "NODE_PATH=$(npm root -g) PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-/opt/pw-browsers} node --test \"test/e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "security": "bash security/scan.sh",
    "render": "node test/helpers/render.js",
    "login": "clasp login",
    "status": "clasp show-file-status",
    "push": "clasp push -f",
    "deploy": "clasp push -f && clasp create-deployment -d \"Shadow IT Dashboard\" ${DEPLOYMENT_ID:+-i $DEPLOYMENT_ID}",
    "deployments": "clasp list-deployments",
    "open": "clasp open-web-app ${DEPLOYMENT_ID:-}"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1"
  },
  "engines": { "node": ">=20" }
}
